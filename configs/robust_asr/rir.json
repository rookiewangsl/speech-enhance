  "test_rooms": 20,
  "test_positions_per_rt60": 3,
  "target_rms_dbfs": -25.0,
  "peak_headroom_db": 1.0,
  "preserve_full_rir_tail": true,
  "additive_noise": false,
  "moving_source": false
}
